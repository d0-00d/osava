{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "start": "node src/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/backend.cjs",
    "compile": "npm run bundle && pkg dist/backend.cjs --targets node22-win-x64 --output ../src-tauri/binaries/osava-backend-x86_64-pc-windows-msvc.exe",
    "test": "echo \"Error: no test specified\" && exit 1",
    "parity": "esbuild scripts/parity-convert.ts --bundle --platform=node --format=cjs --outfile=dist/parity.cjs --log-level=warning && node dist/parity.cjs",
    "parity-explain": "esbuild scripts/parity-explain.ts --bundle --platform=node --format=cjs --outfile=dist/parity-explain.cjs --log-level=warning && node dist/parity-explain.cjs",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=cjs --outfile=dist/selftest.cjs --log-level=warning && node dist/selftest.cjs",
    "eval-llama": "esbuild scripts/eval-llama.ts --bundle --platform=node --format=cjs --outfile=dist/eval-llama.cjs --log-level=warning && node dist/eval-llama.cjs"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.4",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
