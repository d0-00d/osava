{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osava",
  "version": "0.3.0",
  "identifier": "com.ayush.osava",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OSAVA",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/osava-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "d0-00d",
    "copyright": "Copyright (c) 2026 d0-00d",
    "category": "Utility",
    "shortDescription": "Windows security dashboard with local behaviour triage",
    "longDescription": "OSAVA shows Windows protection status, manages ClamAV, and ranks Sysmon events with a small language model that runs entirely on this PC.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
